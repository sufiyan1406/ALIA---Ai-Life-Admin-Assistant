### ALIA Backend - Example environment file
# Copy this to `.env` locally and fill with real values.
# DO NOT commit real secret values into the repository.
# Use your platform's secret store (GitHub Secrets, Vault, etc.) for CI/deployments.

# ----------------------
# Required (Supabase + app)
# ----------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# AI provider keys (NVIDIA NIM, Groq)
NVIDIA_API_KEY=
GROQ_API_KEY=

# CORS / environment
ALLOWED_ORIGINS=http://localhost:3000
APP_ENV=development

# ----------------------
# Optional: SMTP (leave blank to disable email sending)
# ----------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ALIA Assistant

# Notes:
# - Never store production service-role keys in client-side code or frontend.
# - Rotate keys immediately if they were ever committed.
# - Use GitHub Secrets / CI variables for deployment instead of embedding secrets here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# NVIDIA NIM API key - used for synchronous MVP task extraction.
# Current MVP model: meta/llama-3.1-70b-instruct
NVIDIA_API_KEY=your-nvidia-api-key

# Groq API key - used for audio transcription via Whisper.
# Current MVP model: whisper-large-v3
GROQ_API_KEY=your-groq-api-key

ALLOWED_ORIGINS=http://localhost:3000
APP_ENV=development
